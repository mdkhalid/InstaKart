# InstaKart admin app — environment configuration
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# Base URL of the InstaKart API (no trailing slash). The admin app
# appends `/api/v1` for HTTP calls and `/uploads/:path*` is
# rewritten to this URL in next.config.js.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Socket.io connection URL. Same host as the API in dev; can be a
# separate wss:// URL behind a load balancer in production.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
