# ───────────────────────────────────────────────────────────────
# InstantShopping Production Environment Variables
# Copy to .env and fill in all values
# ───────────────────────────────────────────────────────────────

# Database
POSTGRES_USER=instamart
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=instamart_db

# ───────────────────────────────────────────────────────────────
# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# ───────────────────────────────────────────────────────────────
# URLs (adjust for your domain)
# ───────────────────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# ───────────────────────────────────────────────────────────────
# SMTP / Email (required for password reset, order confirmations)
# ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key
EMAIL_FROM=noreply@yourdomain.com

# ───────────────────────────────────────────────────────────────
# Cloudinary (required for image uploads)
# ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ───────────────────────────────────────────────────────────────
# Payment Gateway — choose ONE or both
# ───────────────────────────────────────────────────────────────
# Razorpay (India)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (Global)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# ───────────────────────────────────────────────────────────────
# Delivery Agent (used when no specific agent assigned)
# ───────────────────────────────────────────────────────────────
DEFAULT_DELIVERY_AGENT_NAME=Delivery Agent
DEFAULT_DELIVERY_AGENT_PHONE=+91-XXXXXXXXXX