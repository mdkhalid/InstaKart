# InstaKart API — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# ---------- Server ----------
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins.
# Used for CORS, Socket.io CORS, and email links (password reset).
CLIENT_URL=http://localhost:3000,http://localhost:3001

# ---------- Database ----------
# Prisma reads this directly. Format: postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL=postgresql://instamart:instamart123@localhost:5433/instamart_db

# ---------- Cache ----------
# Set REDIS_ENABLED=false to bypass Redis entirely (in-memory fallback only).
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ---------- Auth ----------
# REQUIRED in production. The defaults are flagged insecure by code.
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# ---------- Order pricing (all optional) ----------
# Free delivery kicks in when subtotal meets or exceeds this threshold.
FREE_DELIVERY_THRESHOLD=499
# Flat delivery fee in INR when subtotal is below the threshold.
DELIVERY_FEE=40
# Tax rate as a decimal (0.05 = 5%).
TAX_RATE=0.05

# ---------- Email (SMTP) — all optional ----------
# When unset, the email service short-circuits to a no-op. Resend SMTP
# defaults are applied for HOST/PORT when SMTP_USER is configured.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@instamart.com

# ---------- File uploads — all optional ----------
# When unset, uploads are written to packages/api/uploads/ and served
# from the Next.js rewrite in apps/web/next.config.js.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Payments — all optional ----------
# When unset, the payment service is in test mode (verifyPayment
# always returns true). DO NOT ship to production without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
